{
  "name": "figle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Extracts a Figma selection into a structured Spec for the AI agent in your IDE.",
  "license": "MIT",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "tsdown": "0.22.0",
    "typescript": "6.0.3"
  }
}
